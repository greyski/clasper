# clasper Ghostty config. GENERATED by install.sh from
# templates/ghostty.config.in -- edit the template, then re-run install.sh.
#
# Your own Ghostty config pulls this file in with a `config-file =` line that
# install.sh adds, so every Ghostty window boots straight into Claude.
# Ghostty loads included files last, so these settings win over yours.

# Every window and tab: one Claude session.
command = @COMMAND@
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false

# Closing a window just closes it; quitting leaves nothing to restore.
confirm-close-surface = false
quit-after-last-window-closed = true
window-save-state = never

# Comfort.
font-size = 14
window-padding-x = 10
window-padding-y = 8

# Dock icon.
@ICON@

# No progress bar across the top of the window (its color can't follow the tint).
progress-style = false
