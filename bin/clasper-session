#!/bin/zsh -l
# clasper-session: one Claude session per Ghostty window. Ghostty runs this as
# its `command` (see templates/ghostty.config.in); it tints the window, then
# execs Claude in bypass mode. Settings come from local/settings.env, and any
# extra arguments are passed through to claude.
#
# Claude's *-ansi themes draw their UI from the terminal palette, so recoloring
# a few palette slots per window recolors the mascot, the bypass line, the
# spinner and inline code to match the window. Slots that carry meaning in the
# dark theme (errors, diffs, code syntax) are left alone.

zmodload zsh/mathfunc
SUITE=${0:A:h:h}
[[ -f $SUITE/local/settings.env ]] && source $SUITE/local/settings.env
: ${CLASPER_COLORS:=random} ${CLASPER_APPEARANCE:=auto} ${CLASPER_CHROME:=1}

# name:hue (degrees). graphite is the neutral one with the classic orange accent.
tints=(indigo:240 teal:180 plum:290 rust:20 forest:140 wine:345 navy:215 olive:60 violet:265 ocean:200 amber:40 graphite:15)

hsl() {  # hsl H S L (S, L in 0-1) -> RRGGBB
  local -F h=$1 s=$2 l=$3 c x m r g b
  (( c = (1 - abs(2 * l - 1)) * s, x = c * (1 - abs(fmod(h / 60.0, 2) - 1)), m = l - c / 2 ))
  case $(( int(h / 60) % 6 )) in
    0) r=$c g=$x b=0 ;; 1) r=$x g=$c b=0 ;; 2) r=0 g=$c b=$x ;;
    3) r=0 g=$x b=$c ;; 4) r=$x g=0 b=$c ;; *) r=$c g=0 b=$x ;;
  esac
  printf '%02x%02x%02x' $(( int(rint((r + m) * 255)) )) $(( int(rint((g + m) * 255)) )) $(( int(rint((b + m) * 255)) ))
}

# Pick a tint: a fixed one from settings, or a random one not used by the last
# few windows so side-by-side windows look different.
recent_file=${XDG_CACHE_HOME:-$HOME/.cache}/clasper/recent
mkdir -p ${recent_file:h}
recent=(${(f)"$(cat $recent_file 2>/dev/null)"})
if [[ -n $CLASPER_TINT && -n ${(M)tints:#$CLASPER_TINT:*} ]]; then
  pick=${(M)tints:#$CLASPER_TINT:*}      # restarting: keep this window's tint
elif [[ $CLASPER_COLORS != random && -n ${(M)tints:#$CLASPER_COLORS:*} ]]; then
  pick=${(M)tints:#$CLASPER_COLORS:*}
else
  pool=()
  for t in $tints; do (( ${recent[(Ie)${t%%:*}]} )) || pool+=$t; done
  (( ${#pool} )) || pool=($tints)
  pick=${pool[$(( RANDOM % ${#pool} + 1 ))]}
fi
name=${pick%%:*} hue=${pick##*:}
[[ -n $CLASPER_TINT ]] || print -l $name ${recent[1,5]} > $recent_file
unset CLASPER_TINT

appearance=$CLASPER_APPEARANCE
if [[ $appearance == auto ]]; then
  [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null) == Dark ]] && appearance=dark || appearance=light
fi
sat=1; [[ $name == graphite ]] && sat=0   # graphite: gray window, orange accent

osc() { printf '\e]%s\a' "$1"; }
if [[ $appearance == dark ]]; then
  theme=dark-ansi
  bg=$(hsl $hue $(( 0.45 * sat )) 0.12) fg=$(hsl $hue $(( 0.15 * sat )) 0.88)
  accent=$(hsl $hue 0.70 0.72) spin=$(hsl $hue 0.60 0.82) code=$(hsl $hue 0.45 0.84)
  osc "4;9;#$accent"; osc "4;11;#$spin"; osc "4;12;#$code"     # mascot+bypass, spinner text, inline code
  osc "4;2;#$spin"; osc "4;10;#$spin"                           # status bullets, /rc
else
  theme=light-ansi
  bg=$(hsl $hue $(( 0.45 * sat )) 0.94) fg=$(hsl $hue $(( 0.30 * sat )) 0.15)
  accent=$(hsl $hue 0.65 0.40) spin=$(hsl $hue 0.60 0.45) code=$(hsl $hue 0.50 0.32)
  osc "4;1;#$accent"; osc "4;9;#$accent"; osc "4;11;#$spin"; osc "4;4;#$code"  # bypass, mascot+spinner, inline code
  osc "4;2;#$spin"; osc "4;3;#$spin"                                           # status labels like /rc
fi
osc "11;#$bg"; osc "10;#$fg"; osc "12;#$accent"   # background, text, cursor
printf '\e]2;Claude · %s\a' $name                 # window title

# Drop markers inherited when launched from inside another Claude session;
# CLAUDE_CODE_CHILD_SESSION in particular turns off transcript saving.
unset CLAUDECODE CLAUDE_PID CLAUDE_EFFORT CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH \
  CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ATTENDED \
  CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_BRIDGE_SESSION_ID

# ~/claude is pre-trusted by install.sh, so starting there skips the folder prompt.
[[ -d "$HOME/claude" ]] && cd "$HOME/claude"
args=(--settings "{\"theme\":\"$theme\",\"terminalProgressBarEnabled\":false}")
(( CLASPER_CHROME )) && args+=(--chrome)

# clasper-migrate hands over a conversation through a one-shot file (line 1:
# session id, line 2: folder). Ghostty keeps its launch env for every later
# window, so the first window claims the file by deleting it and Cmd-N windows
# start fresh.
if [[ -n "$CLASPER_HANDOFF" && -f "$CLASPER_HANDOFF" ]] && mv "$CLASPER_HANDOFF" "$CLASPER_HANDOFF.claimed.$$" 2>/dev/null; then
  handoff=(${(f)"$(<$CLASPER_HANDOFF.claimed.$$)"})
  rm -f "$CLASPER_HANDOFF.claimed.$$"
  [[ -n ${handoff[1]} && ${handoff[1]} != new ]] && args+=(--resume ${handoff[1]})
  [[ -d ${handoff[2]} ]] && cd ${handoff[2]}
fi
unset CLASPER_HANDOFF

# Run Claude as a child rather than exec'ing it, so that after a Cmd-R
# (clasper-restart) this script can start over and resume the conversation.
# Ctrl-C reaches this script too; a no-op trap keeps it alive without changing
# how Claude itself handles the signal.
export CLASPER_WINDOW=$$ PATH=$SUITE/bin:$PATH
trap : INT QUIT
claude --dangerously-skip-permissions "${args[@]}" "$@"
code=$?

restart=${XDG_CACHE_HOME:-$HOME/.cache}/clasper/restart/$$
if [[ -f $restart ]]; then
  export CLASPER_HANDOFF=$restart.handoff CLASPER_TINT=$name
  mv $restart $CLASPER_HANDOFF
  exec $0 "$@"
fi
exit $code
